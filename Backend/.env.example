# MongoDB connection string
MONGO_URI=

# JWT secrets
JWT_SECRET_KEY=
JWT_EXPIRES=7d

# Cookie expiry in days
COOKIE_EXPIRE=7

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Deployed URLs of both frontends (used for CORS)
FRONTEND_PATIENT=
FRONTEND_ADMIN=

# Server port (Vercel ignores this; set to 4000 for local dev)
PORT=4000
